LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM=vox-symposium

AGENT_CITIZEN_IDENTITY=agent-citizen
# openai, gemini, or minicpm
AGENT_CITIZEN_PROVIDER=openai
AGENT_CITIZEN_INSTRUCTIONS=You are Agent-Citizen, representing a human user. Keep replies concise and conversational.

AGENT_SCHOLAR_IDENTITY=agent-scholar
# openai, gemini, or minicpm
AGENT_SCHOLAR_PROVIDER=gemini
AGENT_SCHOLAR_INSTRUCTIONS=You are Agent-Scholar, the voice agent under test. Keep replies concise and conversational.

OPENAI_API_KEY=your_openai_api_key
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin

# OpenAI authentication backend: openai (default) or azure.
OPENAI_BACKEND=openai
# For Azure OpenAI, remove OPENAI_API_KEY and configure these values instead:
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_NAME=your-gpt-realtime-deployment
# Optional: set this only when using an Azure preview API endpoint.
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Gemini authentication backend: ai_studio (default) or vertex.
GEMINI_BACKEND=ai_studio
# For Vertex, remove GEMINI_API_KEY and configure these values instead:
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# MiniCPM-o 4.5 Audio Full-Duplex Gateway. Use wss:// outside a trusted network.
MINICPM_REALTIME_URL=ws://127.0.0.1:8006/v1/realtime?mode=audio
# Optional when authentication is enforced by the reverse proxy.
# MINICPM_API_KEY=your_minicpm_api_key
MINICPM_LENGTH_PENALTY=1.1
# Official protocol recommends approximately one-second float32 input chunks.
MINICPM_INPUT_CHUNK_MS=1000
# Maximum time to wait in the Gateway worker queue and for session creation.
MINICPM_QUEUE_TIMEOUT=300

# Audio defaults. LiveKit publishes 48 kHz PCM; provider input is resampled per adapter.
LIVEKIT_PUBLISH_SAMPLE_RATE=48000
LIVEKIT_FRAME_MS=20

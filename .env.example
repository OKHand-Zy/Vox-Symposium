LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM=vox-symposium

AGENT_CITIZEN_IDENTITY=agent-citizen
# openai, gemini, minicpm, freeze_omni, moshi, or personaplex
AGENT_CITIZEN_PROVIDER=openai
AGENT_CITIZEN_INSTRUCTIONS=You are Agent-Citizen, representing a human user. Keep replies concise and conversational.

AGENT_SCHOLAR_IDENTITY=agent-scholar
# openai, gemini, minicpm, freeze_omni, moshi, or personaplex
AGENT_SCHOLAR_PROVIDER=gemini
AGENT_SCHOLAR_INSTRUCTIONS=You are Agent-Scholar, the voice agent under test. Keep replies concise and conversational.

OPENAI_API_KEY=your_openai_api_key
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin

# OpenAI authentication backend: openai (default) or azure.
OPENAI_BACKEND=openai
# For Azure OpenAI, remove OPENAI_API_KEY and configure these values instead:
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_NAME=your-gpt-realtime-deployment
# Optional: set this only when using an Azure preview API endpoint.
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Gemini authentication backend: ai_studio (default) or vertex.
GEMINI_BACKEND=ai_studio
# For Vertex, remove GEMINI_API_KEY and configure these values instead:
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# MiniCPM-o 4.5 Audio Full-Duplex Gateway. Use wss:// outside a trusted network.
MINICPM_REALTIME_URL=ws://127.0.0.1:8006/v1/realtime?mode=audio
# Optional when authentication is enforced by the reverse proxy.
# MINICPM_API_KEY=your_minicpm_api_key
MINICPM_LENGTH_PENALTY=1.1
# Official protocol recommends approximately one-second float32 input chunks.
MINICPM_INPUT_CHUNK_MS=1000
# Maximum time to wait in the Gateway worker queue and for session creation.
MINICPM_QUEUE_TIMEOUT=300

# Freeze-Omni Real-Time Interactive Demo server.
# Install optional dependencies with: pip install -e '.[freeze-omni]'
# Set AGENT_SCHOLAR_PROVIDER=freeze_omni or AGENT_CITIZEN_PROVIDER=freeze_omni to use it.
# Official server usually runs with a self-signed HTTPS certificate.
# Turn and post-turn settings are used by the evaluation runner; normal LiveKit
# participants keep a continuous audio stream.
# FREEZE_OMNI_REALTIME_URL=https://127.0.0.1:8081
# FREEZE_OMNI_SSL_VERIFY=false
# FREEZE_OMNI_INPUT_CHUNK_MS=20
# FREEZE_OMNI_TURN_START_DELAY=3
# FREEZE_OMNI_TURN_PREROLL_SILENCE_MS=1200
# FREEZE_OMNI_MAX_INPUT_SILENCE_MS=200
# FREEZE_OMNI_INPUT_SILENCE_RMS_THRESHOLD=800
# FREEZE_OMNI_CONNECT_TIMEOUT=60
# FREEZE_OMNI_PROMPT_TIMEOUT=60
# FREEZE_OMNI_CONNECT_RETRIES=10
# FREEZE_OMNI_CONNECT_RETRY_DELAY=5
# FREEZE_OMNI_POST_TURN_POLL_SECONDS=60
# FREEZE_OMNI_POST_TURN_IDLE_SECONDS=3
# FREEZE_OMNI_POST_TURN_POLL_CHUNK_MS=160
# FREEZE_OMNI_STOP_RECORDING_AFTER_TURN=true

# Moshi-compatible servers use /api/chat with 24 kHz mono Opus pages.
# Install optional dependencies with: pip install -e '.[moshi]'
# MOSHI_REALTIME_URL=ws://127.0.0.1:8998/api/chat
# Optional when authentication is enforced by a reverse proxy.
# MOSHI_API_KEY=your_moshi_api_key

# PersonaPlex live server uses the same Moshi /api/chat adapter.
# Keep voice_prompt in the URL; Vox writes each scenario's Scholar instructions
# into text_prompt automatically.
# PERSONAPLEX_REALTIME_URL=ws://127.0.0.1:8998/api/chat?voice_prompt=NATF2.pt
# Optional when authentication is enforced by a reverse proxy.
# PERSONAPLEX_API_KEY=your_personaplex_api_key

# Audio defaults. LiveKit publishes 48 kHz PCM; provider input is resampled per adapter.
LIVEKIT_PUBLISH_SAMPLE_RATE=48000
LIVEKIT_FRAME_MS=20
